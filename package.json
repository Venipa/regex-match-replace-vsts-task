{
	"name": "regex-match-replace-vsts-task",
	"version": "2.0.1",
	"description": "Visual Studio Team Services Task to replace file content with a regex match",
	"main": "index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Venipa/regex-match-replace-vsts-task.git"
	},
	"author": "Venipa <admin@venipa.net>",
	"contributors": [
		{
			"name": "Kasun Kodagoda",
			"url": "https://github.com/kasunkv/regex-match-replace-vsts-task"
		}
	],
	"scripts": {
		"clean": "rimraf dist && npm run clean-js && npm run clean-map",
		"clean-js": "rimraf -g BuildTask/**/*.js",
		"clean-map": "rimraf -g BuildTask/**/*.map",
		"compile": "tsc --project ./BuildTask",
		"move-npm": "mkdir \"dist/BuildTask/RegexMatchReplace\" && copyfiles \"package.json\" \"dist/BuildTask/RegexMatchReplace\"",
		"move-task": "pnpm copyfiles \"./BuildTask/RegexMatchReplace/**/!(*.ts)\" dist",
		"build": "npm run move-npm && pnpm install && npm run compile && npm run move-task",
		"build-clean": "npm run clean && npm run build",
		"publish-local": "tfx build tasks upload --task-path ./dist/BuildTask/RegexMatchReplace",
		"pre": "pretty-quick --staged",
		"prettier": "pretty-quick --pattern \"**/*.ts\"",
		"package": "tfx extension create --manifest-globs vss-extension.json"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged && npm run pre"
		}
	},
	"keywords": [
		"regex",
		"regular-expressions",
		"pattern-match",
		"match",
		"find-and-replace",
		"replace",
		"matching",
		"glob-replace",
		"glob"
	],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Venipa/regex-match-replace-vsts-task/issues"
	},
	"homepage": "https://github.com/Venipa/regex-match-replace-vsts-task#readme",
	"dependencies": {
		"@sentry/node": "^4.1.1",
		"fast-glob": "^3.3.3",
		"vsts-task-lib": "^2.7.0"
	},
	"devDependencies": {
		"@types/node": "^8.0.47",
		"@types/q": "^1.0.6",
		"copyfiles": "^2.4.1",
		"husky": "^6.0.0",
		"lint-staged": "^11.0.0",
		"prettier": "^2.3.2",
		"pretty-quick": "^3.1.1",
		"rimraf": "^6.1.3",
		"tfx-cli": "^0.23.4",
		"tslint": "^6.1.3",
		"tslint-eslint-rules": "^5.4.0",
		"tslint-microsoft-contrib": "^6.2.0",
		"typescript": "^4.3.4"
	}
}
